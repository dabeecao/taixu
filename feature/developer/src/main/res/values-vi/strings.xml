    <string name="developer_text_0049" formatted="false">Đã sẵn sàng</string>
    <string name="developer_text_0050" formatted="false">Đã là mới nhất</string>
    <string name="developer_text_0051" formatted="false">Bảng điều khiển nhà phát triển</string>
    <string name="developer_text_0052" formatted="false">Bất thường</string>
    <string name="developer_text_0053" formatted="false">Số lượng tham chiếu bằng 0</string>
    <string name="developer_text_0054" formatted="false">Hiện không có Runtime dùng chung nào có thể dọn an toàn.</string>
    <string name="developer_text_0055" formatted="false">Hiện không có tiến trình nền nào được đăng ký.</string>
    <string name="developer_text_0056" formatted="false">Khôi phục trạng thái ban đầu của Linux</string>
    <string name="developer_text_0057" formatted="false">Khôi phục trạng thái ban đầu của Linux?</string>
    <string name="developer_text_0058" formatted="false">Thực thi lệnh</string>
    <string name="developer_text_0059" formatted="false">Gợi ý: người kiểm soát được địa chỉ danh sách cũng có thể cung cấp khóa công khai, khóa tự nhập chỉ dùng để chống lỗi truyền tải/kiểm tra tính nhất quán nội dung, không thể chống giả mạo đầu cuối. Nếu cần neo tin cậy thực sự, hãy nhúng cố định khóa công khai vào APK.</string>
    <string name="developer_text_0060" formatted="false">Đã sao chép nhật ký</string>
    <string name="developer_text_0061" formatted="false">Đã sao chép nhật ký vào bộ nhớ tạm</string>
    <string name="developer_text_0062" formatted="false">Có</string>
    <string name="developer_text_0063" formatted="false">Luồng thực thi Agent, lệnh gọi công cụ và chi tiết lỗi được lưu trữ cục bộ</string>
    <string name="developer_text_0064" formatted="false">Nhật ký Agent đã được xóa hết.</string>
    <string name="developer_text_0065" formatted="false">Nhật ký gỡ lỗi cục bộ của Agent</string>
