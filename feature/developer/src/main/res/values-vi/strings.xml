    <string name="developer_text_0020" formatted="false">Tạo không gian làm việc</string>
    <string name="developer_text_0021" formatted="false">Tạo thư mục chạy</string>
    <string name="developer_text_0022" formatted="false">Đang khởi tạo</string>
    <string name="developer_text_0023" formatted="false">Khởi tạo hoàn tất.</string>
    <string name="developer_text_0024" formatted="false">Làm mới</string>
    <string name="developer_text_0025" formatted="false">Hủy</string>
    <string name="developer_text_0026" formatted="false">Hủy tải xuống</string>
    <string name="developer_text_0027" formatted="false">Chỉ xóa các lượt tải xuống chưa kích hoạt và tệp tạm, không ảnh hưởng đến hệ thống Linux, công cụ hay không gian làm việc.</string>
    <string name="developer_text_0028" formatted="false">Runtime có thể dọn</string>
    <string name="developer_text_0029" formatted="false">Tiến trình Linux nền và mức chiếm dụng đĩa</string>
    <string name="developer_text_0030" formatted="false">Tiến trình nền</string>
    <string name="developer_text_0031" formatted="false">Không</string>
    <string name="developer_text_0032" formatted="false">Lệnh không được để trống.</string>
    <string name="developer_text_0033" formatted="false">Chẩn đoán lệnh</string>
    <string name="developer_text_0034" formatted="false">Chạy lệnh Shell một lần trong môi trường Linux cách ly</string>
    <string name="developer_text_0035" formatted="false">Sao chép</string>
    <string name="developer_text_0036" formatted="false">Sao chép tất cả</string>
    <string name="developer_text_0037" formatted="false">Thất bại</string>
    <string name="developer_text_0038" formatted="false">Mức chiếm dụng bộ nhớ</string>
    <string name="developer_text_0039" formatted="false">Sẽ xóa RootFS Linux hiện tại, các công cụ đã cài đặt và bộ nhớ đệm sandbox, nhưng giữ lại dự án /workspace và bộ nhớ dùng chung của điện thoại. Thao tác này không thể hoàn tác.</string>
    <string name="developer_text_0040" formatted="false">Sẽ tải xuống và xác minh phiên bản mới trực tuyến, giữ lại /root và /opt/taixu. Trong lúc cập nhật, các tiến trình Linux nền sẽ dừng; nếu thất bại sẽ tự động khôi phục phiên bản cũ.</string>
    <string name="developer_text_0041" formatted="false">Sẽ gỡ bỏ Runtime dùng chung không được công cụ nào tham chiếu, thao tác này không thể tự động khôi phục.</string>
    <string name="developer_text_0042" formatted="false">Không gian làm việc</string>
    <string name="developer_text_0043" formatted="false">Không gian làm việc có thể ghi</string>
    <string name="developer_text_0044" formatted="false">Dữ liệu công cụ</string>
    <string name="developer_text_0045" formatted="false">Đã lưu cấu hình danh sách công cụ.</string>
    <string name="developer_text_0046" formatted="false">Nguồn công cụ</string>
