<resources>
    <string name="developer_text_0001" formatted="false">Khóa công khai Ed25519 (Base64)</string>
    <string name="developer_text_0002" formatted="false">Môi trường Linux đã được khôi phục về trạng thái ban đầu, dự án trong không gian làm việc không bị xóa.</string>
    <string name="developer_text_0003" formatted="false">Khôi phục môi trường Linux thất bại</string>
    <string name="developer_text_0004" formatted="false">RootFS đã là phiên bản mới nhất.</string>
    <string name="developer_text_0005" formatted="false">Cập nhật RootFS hoàn tất, dữ liệu người dùng được giữ nguyên.</string>
    <string name="developer_text_0006" formatted="false">Khởi tạo Runtime thất bại</string>
    <string name="developer_text_0007" formatted="false">Đã kiểm tra xong năng lực lõi của Runtime</string>
