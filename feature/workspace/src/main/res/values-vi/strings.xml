    <string name="workspace_spec_title">Quy cách tạo mẫu v1</string>
    <string name="workspace_spec_intro">Nén toàn bộ thư mục mẫu thành ZIP. Thư mục gốc của ZIP có thể đặt trực tiếp template.json, hoặc chỉ chứa một thư mục mẫu.</string>
    <string name="workspace_spec_min_structure">Cấu trúc tối thiểu</string>
    <string name="workspace_spec_min_structure_body">template.json\npreview.png (tùy chọn, 270×270)\nTệp dự án hoặc *.template\ntemplate-hooks/ (tùy chọn)</string>
    <string name="workspace_spec_manifest">Yêu cầu manifest</string>
    <string name="workspace_spec_manifest_body">id chỉ được dùng chữ thường, số, dấu chấm, gạch dưới và gạch ngang; tiền tố builtin. là dành riêng cho hệ thống. projectType hỗ trợ ANDROID, FLUTTER, GENERAL. category dùng để nhóm mẫu.</string>
    <string name="workspace_spec_variables">Biến và tệp</string>
    <string name="workspace_spec_variables_body">Tên dự án và đường dẫn tạo do xưởng điền thống nhất. Mẫu khai báo trường động qua variables, hỗ trợ TEXT, MULTILINE, NUMBER, BOOLEAN, SELECT, SECRET. Nội dung và đường dẫn tệp có thể dùng {{variableName}}; mọi tệp văn bản đều có thể thêm hậu tố .template, khi tạo sẽ loại bỏ hậu tố này. Thư mục gói dùng TAIXU_PACKAGE_PATH. Biến bắt buộc bị ẩn phải có giá trị mặc định, trừ biến do hệ thống suy ra.</string>
    <string name="workspace_spec_preview">Ảnh xem trước</string>
    <string name="workspace_spec_preview_body">Hỗ trợ PNG, JPEG, WebP, GIF, mỗi ảnh tối đa 4 MiB. Ảnh xem trước thống nhất tỉ lệ 1:1, kích thước phải là 270×270 px.</string>
    <string name="workspace_spec_hooks">Script dựng</string>
    <string name="workspace_spec_hooks_body">beforeCreate và afterCreate phải trỏ tới script trong template-hooks/. Script chỉ chạy khi người dùng ủy quyền rõ ràng lúc tạo dự án, chạy trong thư mục dự án mới của Linux sandbox, tối đa 60 giây. Biến được truyền qua biến môi trường TAIXU_VAR_&lt;TÊN_BIẾN_VIẾT_HOA&gt;, đường dẫn dự án là TAIXU_PROJECT_DIR.</string>
    <string name="workspace_spec_validation">Kiểm tra kết quả</string>
    <string name="workspace_spec_validation_body">validation có thể khai báo requiredFiles, forbiddenFiles và contentRules; đường dẫn và nội dung hỗ trợ biến mẫu. Việc kiểm tra chạy sau khi afterCreate hoàn tất.</string>
    <string name="workspace_spec_footer">Có thể xuất trước một mẫu có sẵn bất kỳ làm mẫu đầy đủ; trước khi nhập cần đổi id và gỡ tiền tố dành riêng builtin..</string>
